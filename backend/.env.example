# Backend configuration (copy to .env for local dev; never commit real secrets).

# HMAC secret for bearer tokens. Use a long random string in production.
AUTH_SECRET=dev-insecure-secret-change-me

# Local HTTP port for the Node server (src/index.ts).
PORT=8787

# Ed25519 policy-signing keypair, base64 of SPKI (public) / PKCS8 (private) DER.
# If unset, the server generates an EPHEMERAL key on boot (dev only — devices
# can't keep a stable public key across restarts). Generate a stable pair with:
#
#   node -e 'const {subtle}=crypto;(async()=>{const kp=await subtle.generateKey({name:"Ed25519"},true,["sign","verify"]);\
#   const pub=Buffer.from(await subtle.exportKey("spki",kp.publicKey)).toString("base64");\
#   const prv=Buffer.from(await subtle.exportKey("pkcs8",kp.privateKey)).toString("base64");\
#   console.log("SIGNING_PUBLIC_KEY_B64="+pub);console.log("SIGNING_PRIVATE_KEY_B64="+prv);})()'
#
SIGNING_PUBLIC_KEY_B64=
SIGNING_PRIVATE_KEY_B64=

# --- Outbound email -------------------------------------------------------
# Notifications ("your child asked for something") and password-reset codes are
# delivered by POSTing {from,to,subject,text} as JSON to MAIL_ENDPOINT with
# `Authorization: Bearer $MAIL_TOKEN`. Any transactional provider or in-house
# relay that accepts that shape works; no SMTP client and no npm dependency.
# With either value unset, outbound mail is DROPPED (with a warning) — nobody
# is notified of anything.
MAIL_ENDPOINT=
MAIL_TOKEN=
MAIL_FROM=Ajar <no-reply@ajar.family>

# Parent-console page that completes a password reset. The emailed link is
# "<PASSWORD_RESET_URL>?token=<token>". Unset = the email carries the raw code.
PASSWORD_RESET_URL=

# Ops secret gating PUT /v1/categories/dataset (global data). Unset = disabled.
CATEGORY_ADMIN_TOKEN=
