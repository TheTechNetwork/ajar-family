{
  "name": "@ajar/backend",
  "version": "0.0.0-alpha",
  "description": "Cloud backend: family model, policy engine, temporary approvals, access requests, signed policy sync",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "node --watch dist/index.js",
    "test": "npm run build && node --test 'dist/**/*.test.js'",
    "bundle": "esbuild src/index.ts --bundle --platform=node --format=cjs --target=node22 --outfile=dist/backend.cjs",
    "sea:blob": "node --experimental-sea-config sea-config.json",
    "sea": "npm run bundle && node scripts/build-sea.mjs",
    "openapi": "npm run build && node scripts/gen-openapi.mjs",
    "test:workerd": "npm run build && node --test 'test/**/*.test.mjs'"
  },
  "dependencies": {
    "@ajar/shared": "*",
    "@simplewebauthn/server": "13.3.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "esbuild": "^0.28.0",
    "typescript": "^5.9.0",
    "wrangler": "4.127.1"
  }
}
