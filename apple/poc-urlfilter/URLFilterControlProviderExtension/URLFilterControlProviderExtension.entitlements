<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  URL-filter control provider app-extension entitlements (PoC D).

  Entitlement value is `url-filter-provider` (iOS/macOS 26).

  The extension's Info.plist MUST set:
      EXExtensionPointIdentifier = com.apple.networkextension.url-filter-control
  (NEURLFilterControlProvider runs as an APP extension on BOTH iOS and macOS —
  never a system extension.)
-->
<plist version="1.0">
<dict>
    <key>com.apple.developer.networking.networkextension</key>
    <array>
        <string>url-filter-provider</string>
    </array>
</dict>
</plist>
