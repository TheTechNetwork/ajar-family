<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Container-app entitlements for Ajar for Safari.

  The App Group is the whole point: AjarFilter's containing app enrolls this
  device and writes the signed DevicePolicySnapshot into
  group.family.ajar.filter, and the Safari extension reads it back through
  SafariWebExtensionHandler. Without this the extension installs, holds no
  policy, and filters nothing.

  On macOS the container is sandboxed (App Store requirement for a Safari Web
  Extension host); the sandbox keys are ignored on iOS, where every app is
  sandboxed anyway.
-->
<plist version="1.0">
<dict>
    <key>com.apple.security.application-groups</key>
    <array>
        <string>group.family.ajar.filter</string>
    </array>
    <key>com.apple.security.app-sandbox</key>
    <true/>
</dict>
</plist>
