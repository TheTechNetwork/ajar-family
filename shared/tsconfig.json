{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    "declaration": true,
    "outDir": "dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["policy/**/*.ts", "youtube/**/*.ts", "categories/**/*.ts", "net/**/*.ts", "safety/**/*.ts", "trust/**/*.ts", "conformance/**/*.ts"],
  "exclude": ["dist", "node_modules"]
}
