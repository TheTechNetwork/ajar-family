.DS_Store

# Node / TypeScript build
node_modules/
dist/
*.tsbuildinfo

# Local env / secrets (never commit)
.env
.env.*
!.env.example
.dev.vars
.wrangler/

# Generated by XcodeGen from project.yml — regenerate with `xcodegen generate`.
*.xcodeproj/
#
# EVERY Info.plist under apple/ is generated — all nine are declared as an
# `info.path` in some project.yml — so this is a glob, not a list. It was a list,
# enumerated target by target, and it silently missed the two newest targets
# (apple/SafariExtension/ExtensionShim and apple/AjarSafari/App): their generated
# plists showed up as untracked files, which reads as "somebody forgot to commit
# this" and invites exactly the accident described below. A pattern cannot fall
# behind when a target is added or moved.
#
# .entitlements files are also plists and are NOT ignored: those are hand-written
# inputs, not build output, and all eight are tracked.
apple/**/Info.plist
# The PoC path is gone (apple/poc-contentfilter -> apple/AjarFilter). Renaming
# the ignore lines above un-ignored any generated Info.plist still sitting at the
# old path in a working tree, and `git add -A` then committed three of them —
# stale, generated, at a dead path, still displaying "ParentFilter PoC". Ignore
# the whole directory so a stale checkout cannot resurrect it.
apple/poc-contentfilter/
apple/poc-urlfilter/App/Info.plist
apple/poc-urlfilter/URLFilterControlProviderExtension/Info.plist

# Generated by tools/build-bloom/build_bloom.py
apple/poc-urlfilter/Resources/out/

DerivedData/
xcuserdata/

# Go build artifacts
*.exe
windows/agent/ajar-agent.exe

# workerd/miniflare local state written by the workerd live test
.wrangler/

# Signing material. A distribution private key signs releases as us, and a .p12
# bundles it with the cert — neither is ever a repo artifact, and a distribution
# certificate cannot be re-issued against a key you lost. Keep them in the
# password manager, and in GitHub secrets if CI has to import one.
*.key
*.p12
*.mobileprovision
*.certSigningRequest
*.cer

# Transient git worktrees the agent harness creates for parallel work. Each is a
# FULL checkout of this repo; committing them would nest the repo inside itself.
# They are removed when the agent finishes. Only this path is ignored — a real
# .claude/settings.json or skill belongs in version control.
.claude/worktrees/
